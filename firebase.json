{
  "hosting": [
    {
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*"
      ],
      "headers": [
        {
          "source": "/",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(html|js|json|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(woff2|png)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "target": "game",
      "redirects": [
        {
          "source": "/otumo",
          "destination": "https://otumojip.web.app/",
          "type": 302
        },
        {
          "source": "/otumo/**",
          "destination": "https://otumojip.web.app/",
          "type": 302
        }
      ]
    },
    {
      "target": "otumo",
      "public": "otumo-site",
      "ignore": [
        "**/.*"
      ],
      "headers": [
        {
          "source": "**/*.@(html|js|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        }
      ]
    }
  ],
  "database": {
    "rules": "database.rules.json"
  }
}
